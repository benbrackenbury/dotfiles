{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.agents"
        }
      ],
      "left": [
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omamail",
          "refreshIntervalSec": 120,
          "maxMessages": 50,
          "heavyMessageRendering": "Show plain text first",
          "contentDirection": "Auto",
          "appearance": "System",
          "defaultQuery": "in:inbox",
          "notifyNewMail": "On",
          "oauthPort": 9481,
          "undoSendSeconds": 10,
          "unifiedCalendarView": true,
          "calendarRemindersEnabled": true,
          "calendarSnoozeMinutes": 5,
          "showBarIcon": true,
          "unifiedMailboxes": false,
          "suggestEvents": false,
          "aiAgent": "System default",
          "aiModel": ""
        },
        {
          "id": "netmojo.omdrop"
        },
        {
          "id": "omarchy.tailscale",
          "recentMullvadRegions": [
            "USA\nChicago, IL"
          ]
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "io.github.thisisgm.omapods"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "io.github.geoochi.mac-battctl",
          "showPercentage": false
        },
        {
          "id": "omarchy.power"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        }
      ]
    },
    "position": "top",
    "transparent": true,
    "id": "io.github.crumble21.notch-bar"
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "dutchbase.monitor-arrange"
    }
  ],
  "version": 1
}
