write_state_derived() {
	mkdir -p "${STATE_DIR}"
	if has_colors; then
		emit_fzf >"${STATE_DIR}/fzf"
		emit_tmux >"${STATE_DIR}/tmux.conf"
		emit_gitconfig >"${STATE_DIR}/gitconfig"
		emit_lazygit >"${STATE_DIR}/lazygit.yml"
	else
		rm -f "${STATE_DIR}/fzf" "${STATE_DIR}/tmux.conf" "${STATE_DIR}/lazygit.yml"
		printf '# no themekit colours\n' >"${STATE_DIR}/gitconfig"
	fi
}

apply_bat() {
	if ! has_colors || ! command -v bat >/dev/null 2>&1; then
		return 0
	fi
	local dir="${CONFIG_HOME}/bat/themes"
	mkdir -p "${dir}" "${CONFIG_HOME}/bat"
	emit_bat_tmtheme >"${dir}/themekit.tmTheme"
	if [[ -f "${CONFIG_HOME}/bat/config" ]]; then
		if grep -q '^--theme' "${CONFIG_HOME}/bat/config"; then
			sed -i.bak 's/^--theme.*/--theme="themekit"/' "${CONFIG_HOME}/bat/config"
			rm -f "${CONFIG_HOME}/bat/config.bak"
		else
			printf '\n--theme="themekit"\n' >>"${CONFIG_HOME}/bat/config"
		fi
	else
		printf '--theme="themekit"\n' >"${CONFIG_HOME}/bat/config"
	fi
	bat cache --build >/dev/null 2>&1 || true
}

apply_vscode() {
	[[ "${OSTYPE:-}" == darwin* ]] || return 0
	[[ -n "${THEME_VSCODE}" ]] || return 0
	python3 - "${THEME_VSCODE}" <<'PY' || true
import json, sys
from pathlib import Path
name = sys.argv[1]
homes = [
    Path.home() / "Library/Application Support/Cursor/User/settings.json",
    Path.home() / "Library/Application Support/Code/User/settings.json",
]
for path in homes:
    if not path.is_file():
        continue
    try:
        data = json.loads(path.read_text())
    except json.JSONDecodeError:
        continue
    if not isinstance(data, dict):
        continue
    if data.get("workbench.colorTheme") == name:
        continue
    data["workbench.colorTheme"] = name
    path.write_text(json.dumps(data, indent=2) + "\n")
PY
}

apply_obsidian() {
	[[ "${OSTYPE:-}" == darwin* ]] || return 0
	[[ -n "${THEME_OBSIDIAN}" ]] || return 0
	python3 - "${THEME_OBSIDIAN}" <<'PY' || true
import json, sys
from pathlib import Path
name = sys.argv[1]
index = Path.home() / "Library/Application Support/obsidian/obsidian.json"
if not index.is_file():
    raise SystemExit(0)
try:
    data = json.loads(index.read_text())
except json.JSONDecodeError:
    raise SystemExit(0)
vaults = data.get("vaults") or {}
for vault in vaults.values():
    if not isinstance(vault, dict):
        continue
    root = vault.get("path")
    if not root:
        continue
    appearance = Path(root) / ".obsidian" / "appearance.json"
    if not appearance.is_file():
        continue
    try:
        cfg = json.loads(appearance.read_text())
    except json.JSONDecodeError:
        cfg = {}
    if not isinstance(cfg, dict):
        continue
    if cfg.get("cssTheme") == name:
        continue
    cfg["cssTheme"] = name
    appearance.write_text(json.dumps(cfg, indent=2) + "\n")
PY
}

reload_tmux() {
	command -v tmux >/dev/null 2>&1 || return 0
	tmux has-session 2>/dev/null || return 0
	local conf="${CONFIG_HOME}/tmux/tmux.conf"
	if [[ -f "${conf}" ]]; then
		tmux source-file "${conf}" >/dev/null 2>&1 || true
	elif [[ -f "${STATE_DIR}/tmux.conf" ]]; then
		tmux source-file "${STATE_DIR}/tmux.conf" >/dev/null 2>&1 || true
	fi
}
