# Generated from theme.toml [colors]. Sourced by themekit.
# Writes state files; optional app configs are merged, not replaced.

has_colors() {
	[[ -n "${COLOR_BG}" && -n "${COLOR_FG}" ]]
}

emit_ghostty_palette() {
	has_colors || return 0
	cat <<EOF
background = ${COLOR_BG}
foreground = ${COLOR_FG}
cursor-color = ${COLOR_CURSOR:-$COLOR_FG}
selection-background = ${COLOR_SEL_BG:-$COLOR_BG}
selection-foreground = ${COLOR_SEL_FG:-$COLOR_FG}
palette = 0=${COLOR_BLACK:-$COLOR_BG}
palette = 1=${COLOR_RED}
palette = 2=${COLOR_GREEN}
palette = 3=${COLOR_YELLOW}
palette = 4=${COLOR_BLUE}
palette = 5=${COLOR_MAGENTA}
palette = 6=${COLOR_CYAN}
palette = 7=${COLOR_WHITE:-$COLOR_FG}
palette = 8=${COLOR_BRIGHT_BLACK:-$COLOR_FG}
palette = 9=${COLOR_BRIGHT_RED:-$COLOR_RED}
palette = 10=${COLOR_BRIGHT_GREEN:-$COLOR_GREEN}
palette = 11=${COLOR_BRIGHT_YELLOW:-$COLOR_YELLOW}
palette = 12=${COLOR_BRIGHT_BLUE:-$COLOR_BLUE}
palette = 13=${COLOR_BRIGHT_MAGENTA:-$COLOR_MAGENTA}
palette = 14=${COLOR_BRIGHT_CYAN:-$COLOR_CYAN}
palette = 15=${COLOR_BRIGHT_WHITE:-$COLOR_FG}
EOF
	if [[ -n "${THEME_FONT}" ]]; then
		printf 'font-family = "%s"\n' "${THEME_FONT}"
	fi
}

