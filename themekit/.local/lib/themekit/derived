emit_fzf() {
	has_colors || return 1
	cat <<EOF
# generated by themekit — sourced from fzf.zsh
export FZF_DEFAULT_OPTS="\${FZF_DEFAULT_OPTS} --color=bg:${COLOR_BG},fg:${COLOR_FG},hl:${COLOR_GREEN},bg+:${COLOR_SEL_BG},fg+:${COLOR_SEL_FG},hl+:${COLOR_YELLOW},info:${COLOR_CYAN},prompt:${COLOR_GREEN},pointer:${COLOR_MAGENTA},marker:${COLOR_YELLOW},spinner:${COLOR_CYAN},header:${COLOR_BLUE},border:${COLOR_BRIGHT_BLACK}"
EOF
}

emit_tmux() {
	has_colors || return 1
	cat <<EOF
# generated by themekit
set -g status-style bg=default,fg=${COLOR_BRIGHT_BLACK:-$COLOR_FG}
set -g status-left "#[fg=${COLOR_YELLOW},bold]#S #[fg=${COLOR_YELLOW},nobold]| "
set -g window-status-current-style fg=${COLOR_YELLOW}
set -g mode-style "bg=${COLOR_YELLOW},fg=${COLOR_BG}"
set -g pane-border-style fg=${COLOR_BRIGHT_BLACK:-$COLOR_BG}
set -g pane-active-border-style fg=${COLOR_GREEN}
set -g message-style bg=${COLOR_SEL_BG:-$COLOR_BG},fg=${COLOR_FG}
EOF
}

emit_gitconfig() {
	has_colors || return 1
	cat <<EOF
# generated by themekit
[delta]
	minus-style = "syntax ${COLOR_BG}"
	minus-emph-style = "syntax ${COLOR_RED}"
	plus-style = "syntax ${COLOR_BG}"
	plus-emph-style = "syntax ${COLOR_GREEN}"
	line-numbers-minus-style = "${COLOR_RED}"
	line-numbers-plus-style = "${COLOR_GREEN}"
	line-numbers-zero-style = "${COLOR_BRIGHT_BLACK:-$COLOR_FG}"
	map-styles = "bold purple => syntax ${COLOR_MAGENTA}, bold cyan => syntax ${COLOR_CYAN}, bold yellow => syntax ${COLOR_YELLOW}"
EOF
}

