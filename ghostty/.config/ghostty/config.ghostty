font-family = "JetBrainsMono NF"
font-size = 15

shell-integration-features = no-cursor

keybind = global:ctrl+opt+cmd+t=toggle_quick_terminal
keybind = global:ctrl+cmd+t=new_window

macos-option-as-alt = true
keybind = alt+3=text:#

term = "tmux-256color"
auto-update = "download"
auto-update-channel = "stable"

config-file = ?~/.local/state/themekit/ghostty
config-file = ?~/.config/ghostty/local.ghostty
